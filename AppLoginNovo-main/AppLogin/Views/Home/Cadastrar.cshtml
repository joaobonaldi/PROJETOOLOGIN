@model AppLogin.Models.Cliente

@{
    ViewData["Title"] = "Cadastrar";
}

<h1>Cadastrar</h1>

<h4>Cliente</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Cadastrar" asp-controller="Home" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input type="text" asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nascimento" class="control-label"></label>
                <input type="date" asp-for="Nascimento" class="form-control"  />
                <span asp-validation-for="Nascimento"></span>
            </div>

            <div class="form-group">
                <label class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Sexo" value="M">
                    <span class="form-check-label"> Masculino</span>
                </label>
                <label class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Sexo" value="F">
                    <span class="form-check-label"> Feminino</span>
                </label>
                <span asp-validation-for="Sexo"></span>
            </div>

            <div class="form-group">
                <label asp-for="CPF">CPF</label>
                @if (ViewData["MSG_CPF"] != null)
                {
                    <p class="alert alert-danger">@Html.Raw(ViewData["MSG_CPF"])</p>        
                }
                <input type="text" asp-for="CPF" class="form-control CPF" placeholder="000.000.000-00">
                <span asp-validation-for="CPF"></span>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Telefone">Telefone</label>
                    <input type="text" asp-for="Telefone" class="form-control Telefone" placeholder="(00) 0000-0000">
                    <span asp-validation-for="Telefone"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                @if (ViewData["MSG_Email"] != null)
                {
                    <p class="alert alert-danger">@Html.Raw(ViewData["MSG_Email"])</p>
                }
                <input type="text" asp-for="Email" class="form-control">
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-group">
                <label asp-for="Senha">Senha</label>
                <input type="password" asp-for="Senha" class="form-control" />
                <span asp-validation-for="Senha"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary btn-block"> Cadastrar </button>
            </div>

            <div class="border-top card-body text-center">Já tem uma conta? <a asp-action="Login" asp-controller="Home">Entrar</a></div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
